# Copy to `.env` in this folder (or use `.env.local`). Do not commit real secrets.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase ---------------------------------------------------------------
# Vercel: Project → Settings → Environment Variables → Production (and Preview if needed).
# NEXT_PUBLIC_* values are baked in at `next build` — change env → Redeploy for login/API to see them.
#
# Local / demo without a live project: keep OFFLINE true. Site uses static fleet data.
# Production: omit NEXT_PUBLIC_SUPABASE_OFFLINE or set false; add URL + anon + service_role from Dashboard → API.
NEXT_PUBLIC_SUPABASE_OFFLINE=true

# OpenAI — required for per-listing chatbot
OPENAI_API_KEY=
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_jwt
SUPABASE_SERVICE_ROLE_KEY=your_service_role_jwt

# Auth confirmation / magic-link / reset-password emails are sent by Supabase Auth,
# not by this app. Branding: paste HTML from supabase/email-templates/ into
# Dashboard → Authentication → Email Templates. To send From support@campervansrental.com,
# configure Custom SMTP in Dashboard → Authentication → SMTP (verify domain + SPF/DKIM).

# --- Stripe (test keys in dev) ---------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
# Required for embedded Checkout on /checkout (returned to the browser to load Stripe.js)
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Reservation fee charged at checkout is 25% of trip total (rent + fees), excluding vehicle security deposit — see lib/booking-pricing.ts
# Host payout onboarding uses Stripe Connect on the *platform* account (STRIPE_SECRET_KEY).
# Set false if Connect is blocked (e.g. Atlas) until you use a Connect-enabled account.
NEXT_PUBLIC_STRIPE_HOST_CONNECT=false

# Transactional email (booking confirmations after Stripe payment)
# https://resend.com — verify your domain and set a From address that matches it.
RESEND_API_KEY=
# Example: "Camper Vans Rental <bookings@yourdomain.com>" (omit to use Resend onboarding sender in dev only)
RESEND_FROM=

# --- Host calendar sync --------------------------------------------------------
# Random secret for securing the Vercel Cron endpoint (/api/cron/sync-external-calendars).
# Generate with: openssl rand -hex 32
CRON_SECRET=

# HMAC-SHA256 secret for signing ICS export URLs (/api/host/calendar/export/[listingId]).
# Generate with: openssl rand -hex 32
CALENDAR_EXPORT_SECRET=
