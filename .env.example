# Copy to `.env` in this folder (or use `.env.local`). Do not commit real secrets.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase ---------------------------------------------------------------
# Local / demo without a live project: keep OFFLINE true. Site uses static fleet data.
# With a real project: set OFFLINE false, set URL + anon + service_role from Dashboard → API.
NEXT_PUBLIC_SUPABASE_OFFLINE=true
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_jwt
SUPABASE_SERVICE_ROLE_KEY=your_service_role_jwt

# --- Stripe (test keys in dev) ---------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_DEPOSIT_CENTS=10000

# Optional
RESEND_API_KEY=
